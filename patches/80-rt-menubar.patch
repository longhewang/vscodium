+	private appendContributedMenus(menubar: Menu): void {
+		const builtins = new Set(['File', 'Edit', 'Selection', 'View', 'Go', 'Run', 'Terminal', 'Help', 'Preferences', 'Window']);
+		const entries = Object.entries(this.menubarMenus);
+		for (let index = 0; index < entries.length; index++) {
+			const [id, menuData] = entries[index];
+			if (builtins.has(id) || !menuData.label || menuData.items.length === 0) {
+				continue;
+			}
+			const submenu = new Menu();
+			this.setMenuById(submenu, id);
+			const followingIds = new Set(entries.slice(index + 1).map(([key]) => key));
+			const before = menubar.items.findIndex(item => followingIds.has(item.id));
+			menubar.insert(before < 0 ? menubar.items.length : before, new MenuItem({
+				id,
+				label: this.mnemonicLabel(menuData.label),
+				submenu
+			}));
+		}
 	}
 
